# ThinkPixelSR operator configuration; parsed as data, never sourced.
# See docs/configuration.md. No tokens, passwords or key contents belong here.
# Choose dev explicitly (or use --env dev). Prod has no configuration yet.
ENV=

# Optional paths. Blank uses the existing selected-environment file.
# Relative paths resolve from the repository root, including quoted paths.
# Keep sensitive files in a private directory with mode 600 on POSIX systems.
# One .secrets.hcl supplies both hcloud_token and hetznerdns_token in inputs.
SECRETS_FILE=
MASTER_PUBLIC_KEY_FILE=
MASTER_PRIVATE_KEY_FILE=
WORKER_PUBLIC_KEY_FILE=
WORKER_PRIVATE_KEY_FILE=
MANAGEMENT_PUBLIC_KEY_FILE=

# Cluster settings remain in cluster/live/<ENV>/terragrunt.hcl and its existing
# secrets inputs merge. Flux declarations and Docker/CI image settings retain
# their own consumers; this phase adds no cluster, registry or image overrides.
