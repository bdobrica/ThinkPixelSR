{
    "name": "thinkpixel/sr",
    "description": "Existing-key PHP client for the ThinkPixelSR Search/RAG gateway",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-curl": "*",
        "guzzlehttp/guzzle": "^7.9",
        "guzzlehttp/psr7": "^2.7",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "ThinkPixel\\SR\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ThinkPixel\\SR\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "lint": "@php tests/lint.php"
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/vendor",
            "/dist",
            "/.gitignore",
            "/.bumpversion.cfg",
            "/phpunit.xml",
            "/phpstan.neon",
            "/composer.lock",
            "/.phpunit.cache"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "extra": {
        "sdk-version": "0.1.0"
    }
}
