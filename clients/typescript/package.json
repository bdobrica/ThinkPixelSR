{
  "name": "@thinkpixel/sr",
  "version": "0.1.0",
  "description": "Existing-key Node.js client for the ThinkPixelSR gateway",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "format": "prettier --write src examples tests package.json package-lock.json tsconfig.json tsconfig.examples.json",
    "format:check": "prettier --check src examples tests package.json package-lock.json tsconfig.json tsconfig.examples.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.9.10",
    "typescript": "~5.6.3"
  },
  "prettier": {
    "tabWidth": 2,
    "printWidth": 80,
    "singleQuote": false,
    "trailingComma": "all"
  }
}
